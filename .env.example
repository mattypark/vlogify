# vlogify -- environment template. Copy to .env (gitignored) and fill in yourself.
#
# The iOS app reads none of this. Its backend keys live in ios/Vlogify/Secrets.xcconfig
# (see ios/Vlogify/Secrets.xcconfig.example). This file is for the backend session's
# tooling (Supabase CLI, R2 sync, the companion site) once that work starts.
#
# The app is built to boot with NO keys at all. Absent keys switch it to the on-device
# mock backend rather than crashing, and the *presence* of a key is the switch rather
# than a separate flag -- a flag can disagree with reality, a key cannot.

# --- Supabase (backend session) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (backend session): clip storage ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vlogify-clips
R2_PUBLIC_BASE_URL=

# --- Apple push (backend session) ---
APNS_KEY_ID=
APNS_TEAM_ID=R43H5332KH
APNS_BUNDLE_ID=com.matthewpark.vlogify

# --- Google sign-in (backend session; the app itself holds no client secret) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Telegram (overnight harness notifications, optional; ~/bin/tg already has its own) ---
TG_SOURCE=vlogify
