# Copy to .dev.vars (gitignored) for `wrangler dev`. Names only here -- never commit values.
# In production every one of these is a `wrangler secret put`; scripts/deploy-worker.sh
# generates the four required ones and never prints them.

# Signs the session tokens the app sends as `Authorization: Bearer`. Any long random string.
SESSION_SECRET=
# HMAC key for the Apple subject: only HMAC(PEPPER, sub) is stored. Changing it orphans every
# account, so set it once.
PEPPER=
# Signs the upload and download URLs the Worker mints for itself (no R2 API keys exist).
MEDIA_SIGNING_KEY=
# AES-256 key, base64 (`openssl rand -base64 32`). Seals the Apple refresh token at rest.
TOKEN_KEY=

# Optional. Sign in with Apple key (developer.apple.com -> Keys, "Sign in with Apple").
# Without them sign-in still works; deleting an account just can't revoke Apple's grant.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional. A Telegram bot that texts when someone files a report or a support message.
TG_BOT_TOKEN=
TG_CHAT_ID=
