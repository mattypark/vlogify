    },
    "%@ is open. your two seconds?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is open. your two seconds?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 열렸어요. 2초 찍을래요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ がはじまったよ。2秒撮る？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 開放了。來拍你的兩秒？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ đã mở. hai giây của bạn?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ открыт. твои две секунды?"
          }
        }
      }
    },
