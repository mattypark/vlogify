    },
    "one nudge an hour, same moment as your friends.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "one nudge an hour, same moment as your friends."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 시간에 한 번, 친구들과 같은 순간에 알려줘요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1時間に1回、友だちと同じ瞬間にお知らせ。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每小時提醒一次，和朋友同一時刻。"
          }
