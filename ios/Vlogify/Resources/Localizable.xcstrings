    "once an hour, everyone in your room\ngets the same nudge.\ntwo seconds. one take. no redo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "once an hour, everyone in your room\ngets the same nudge.\ntwo seconds. one take. no redo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 시간에 한 번, 방 모두가\n같은 알림을 받아요.\n2초. 한 번. 다시 찍기 없음."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1時間に1回、ルームのみんなに\n同じ通知が届く。\n2秒。1テイク。撮り直しなし。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每小時一次，房間裡的每個人\n收到同一個提醒。\n兩秒。一次拍。不能重拍。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "mỗi giờ một lần, cả phòng bạn\nnhận cùng một lời nhắc.\nhai giây. một lần quay. không quay lại."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "раз в час все в твоей комнате\nполучают одно напоминание.\nдве секунды. один дубль. без пересъёмки."
          }
        }
      }
    },
    "once an hour, your whole room\ngets the same nudge.\ntwo seconds. one take.\nno redo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "once an hour, your whole room\ngets the same nudge.\ntwo seconds. one take.\nno redo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 시간에 한 번, 방 모두가\n같은 알림을 받아요.\n2초. 한 번.\n다시 찍기 없음."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1時間に1回、ルームのみんなに\n同じ通知が届く。\n2秒。1テイク。\n撮り直しなし。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每小時一次，整個房間\n收到同一個提醒。\n兩秒。一次拍。\n不能重拍。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "mỗi giờ một lần, cả phòng\nnhận cùng một lời nhắc.\nhai giây. một lần quay.\nkhông quay lại."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
