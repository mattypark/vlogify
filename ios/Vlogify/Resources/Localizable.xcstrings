            "value": "одно напоминание в час, в тот же момент, что и друзьям."
          }
        }
      }
    },
    "one nudge an hour.\nsame minute as your friends,\nso you all film the same moment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "one nudge an hour.\nsame minute as your friends,\nso you all film the same moment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 시간에 알림 하나.\n친구들과 같은 분에 와서,\n모두가 같은 순간을 찍어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1時間に1回の通知。\n友だちと同じ分に届くから、\nみんなで同じ瞬間を撮れる。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每小時一次提醒。\n和朋友同一分鐘，\n大家拍下同一個時刻。"
          }
