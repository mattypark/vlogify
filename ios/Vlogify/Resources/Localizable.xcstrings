    "a face, a star, a squiggle, your initial. it signs every clip you take.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a face, a star, a squiggle, your initial. it signs every clip you take."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼굴, 별, 낙서, 이니셜 뭐든요. 찍는 모든 클립에 서명이 돼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "顔でも星でも、ぐるぐるでもイニシャルでも。撮るクリップ全部のサインになるよ。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一張臉、一顆星、一團塗鴉或你的縮寫。它會簽在你拍的每段片段上。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "một khuôn mặt, ngôi sao, nét nguệch ngoạc, chữ cái đầu. nó ký lên mọi clip bạn quay."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "лицо, звезда, закорючка, твоя буква. это подпись на каждом твоём клипе."
          }
        }
      }
    },
