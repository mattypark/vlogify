        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하면 계정, 클립, 내가 만든 방이 모두 사라져요. 되돌릴 수 없어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "削除するとアカウント、クリップ、作成したルームが消えます。元に戻せません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
