    "deleting removes your account, your clips, and the rooms you own. it cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "deleting removes your account, your clips, and the rooms you own. it cannot be undone."
          }
