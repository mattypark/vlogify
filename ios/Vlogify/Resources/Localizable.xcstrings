    "%@. what's in front of you?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. what's in front of you?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 지금 눈앞엔 뭐가 있어요?"
