    "each hour your room gets a nudge at the same minute. film two seconds of whatever is in front of you." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "each hour your room gets a nudge at the same minute. film two seconds of whatever is in front of you."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "毎時、ルームのみんなに同じ分に通知が届くよ。目の前のものを2秒撮ろう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매시간 방 모두가 같은 분에 알림을 받아요. 눈앞에 있는 걸 2초만 찍어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "каждый час комната получает напоминание в одну и ту же минуту. сними две секунды того, что перед тобой."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "mỗi giờ phòng bạn nhận một lời nhắc cùng một phút. quay hai giây những gì trước mắt."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每小時，房間裡的人會在同一分鐘收到提醒。拍下眼前兩秒就好。"
          }
        }
      }
    },
