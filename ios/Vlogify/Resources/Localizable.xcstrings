    "a room just for you has no limits. days turn over at 4 am." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a room just for you has no limits. days turn over at 4 am."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自分だけのルームは制限なし。1日は朝4時に切り替わるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나만의 방은 제한이 없어요. 하루는 새벽 4시에 넘어가요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "в комнате только для тебя нет ограничений. день сменяется в 4 утра."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "phòng chỉ cho riêng bạn thì không giới hạn. ngày mới bắt đầu lúc 4 giờ sáng."
