// The build settings the app reads its backend from. Committed, and empty on purpose.
//
// Values come from Secrets.xcconfig, which is gitignored. The ? makes the include
// optional: with no such file these stay empty, Info.plist gets empty strings, and the
// app runs entirely on the on-device mock backend -- a working state, not a broken
// one. That is what every screenshot in this repo was taken against.
SUPABASE_URL =
SUPABASE_ANON_KEY =
MEDIA_BASE_URL =

#include? "Secrets.xcconfig"
