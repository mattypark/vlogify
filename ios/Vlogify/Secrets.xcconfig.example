// Copy to Secrets.xcconfig (gitignored) and fill in, once the backend session has a
// project up. Absent is a working state: the app runs fully on the mock backend.
//
// xcconfig treats // as a comment, so a URL cannot be written straight. $() is an empty
// substitution placed BETWEEN the two slashes; the value that reaches Info.plist is the
// full URL. (Putting it before the slashes does not work -- the comment wins.)
SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY =
MEDIA_BASE_URL = https:/$()/media.vlogify.app
